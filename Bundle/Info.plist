	<true/>

	<!--
	  Usage strings for every permission the app can request. A missing usage
	  string is a hard crash at the moment of the request, not a denial.
	-->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Ledge shows your next event and a calendar in the notch.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Ledge uses your location to show local weather. You can pick a city manually instead.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Ledge shows connection and battery for your AirPods and other Bluetooth devices.</string>
	<key>NSFocusStatusUsageDescription</key>
	<string>Ledge shows a card when you switch a Focus on or off.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Ledge reads what Music and Spotify are playing so it can show playback in the notch.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Ledge parks new screenshots on its shelf, so it needs to read them where macOS saves them.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Ledge shows the files you drop on the notch, including ones from Downloads.</string>
	<key>NSDocumentsFolderUsageDescription</key>
