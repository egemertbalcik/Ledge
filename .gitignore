# SwiftPM build products. `.build` alone is ~500 MB. Package.resolved is NOT
# ignored: it pins Sparkle, so a fresh clone builds against the same version.
.build/
# Per-agent scratch paths: parallel builds collide in one .build, so each gets
# its own. They are build products all the same.
.build-*/
.swiftpm/

# Generated by `make icon` — rebuilt from Sources, not source itself.
build/

# The bundled, signed app lives outside the tree ($HOME/Library/Developer/Ledge),
# but ignore it here too in case BUILD_ROOT is pointed at the checkout.
*.app/

# Snapshots taken while developing.
*.tgz

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Xcode, when the package is opened there
xcuserdata/
*.xcuserstate
DerivedData/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Internal review notes. Kept outside the repository entirely;
# see ~/Library/Developer/Ledge/audits.
docs/audits/

# Scratch work — concepts, mockups, anything mid-thought.
work/

# Briefs handed to the other agents working on this app. Scaffolding for a
# conversation, not a record of the app.
.ledge-briefs/
